--- a/util/merge_obj_text.sh
+++ b/util/merge_obj_text.sh
@@ -24,8 +24,14 @@
 
 for arg in "$@"
 do
-    echo -n "${linker} -m aicorelinux -Ttext=0 ${arg} -o ${arg}"
+    # Keep compiler-owned ET_REL objects intact for incremental builds.
+    output="${arg}.merged"
+    temporary="${output}.tmp.$$"
+    trap 'rm -f -- "$temporary"' EXIT
+    echo "${linker} -m aicorelinux -Ttext=0 ${arg} -o ${output}"
     # template kernel text sections will be named as .text.<mangle> like .text._Z11hello_worldILi300EhEvT0_f
     # to remain consistent with none template kernels, merge them into .text
-    ${linker} -m aicorelinux -Ttext=0 ${arg} -o ${arg}
+    "${linker}" -m aicorelinux -Ttext=0 "${arg}" -o "${temporary}"
+    mv -f -- "$temporary" "$output"
+    trap - EXIT
 done
