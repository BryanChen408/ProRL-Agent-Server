{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "description": "RL-Insight Prometheus data source", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "annotations": {"list": []},
  "description": "Polar Gateway rollout, inference, and RL-Insight export health.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"editorMode": "code", "expr": "min(up{job=\"polar-gateway\",node_id=~\"$node_id\"})", "legendFormat": "Gateway up", "range": true, "refId": "A"}],
      "title": "Gateway Up", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 1, "showPoints": "never", "stacking": {"group": "A", "mode": "normal"}}}, "overrides": []},
      "gridPos": {"h": 8, "w": 10, "x": 4, "y": 0}, "id": 2,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (stage) (polar_gateway_sessions{node_id=~\"$node_id\"})", "legendFormat": "{{stage}}", "range": true, "refId": "A"}],
      "title": "Session Queue and Inflight", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0}, "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (status) (increase(polar_sessions_total{node_id=~\"$node_id\"}[$__rate_interval]))", "legendFormat": "{{status}}", "range": true, "refId": "A"}],
      "title": "Session Outcomes", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(polar_session_duration_seconds_bucket{node_id=~\"$node_id\"}[$__rate_interval])))", "legendFormat": "session p95", "range": true, "refId": "A"}],
      "title": "Session Duration P95", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}, "unit": "tps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"editorMode": "code", "expr": "sum by (engine, direction) (rate(polar_inference_tokens_total{node_id=~\"$node_id\"}[$__rate_interval]))", "legendFormat": "{{engine}} {{direction}}", "range": true, "refId": "A"}],
      "title": "Inference Token Throughput", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"editorMode": "code", "expr": "sum by (engine) (rate(polar_inference_requests_total{node_id=~\"$node_id\"}[$__rate_interval]))", "legendFormat": "{{engine}}", "range": true, "refId": "A"}],
      "title": "Inference Request Rate", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(polar_inference_request_duration_seconds_bucket{node_id=~\"$node_id\"}[$__rate_interval])))", "legendFormat": "{{engine}} request", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(polar_inference_ttft_seconds_bucket{node_id=~\"$node_id\"}[$__rate_interval])))", "legendFormat": "{{engine}} TTFT", "range": true, "refId": "B"}
      ],
      "title": "Inference Request and TTFT P95", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(polar_inference_queue_seconds_bucket{node_id=~\"$node_id\"}[$__rate_interval])))", "legendFormat": "{{engine}} queue", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(polar_inference_prefill_seconds_bucket{node_id=~\"$node_id\"}[$__rate_interval])))", "legendFormat": "{{engine}} prefill", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(polar_inference_decode_seconds_bucket{node_id=~\"$node_id\"}[$__rate_interval])))", "legendFormat": "{{engine}} decode", "range": true, "refId": "C"}
      ],
      "title": "Engine Phase Latency P95", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never"}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"editorMode": "code", "expr": "sum by (engine) (rate(polar_inference_prefix_cache_hit_ratio_sum{node_id=~\"$node_id\"}[$__rate_interval])) / sum by (engine) (rate(polar_inference_prefix_cache_hit_ratio_count{node_id=~\"$node_id\"}[$__rate_interval]))", "legendFormat": "{{engine}}", "range": true, "refId": "A"}],
      "title": "Average Prefix Cache Hit Ratio", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "id": 10,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"editorMode": "code", "expr": "sum(polar_observability_export_failures_total{node_id=~\"$node_id\"})", "legendFormat": "OTLP failures", "range": true, "refId": "A"}],
      "title": "OTLP Export Failures", "type": "stat"
    }
  ],
  "refresh": "10s", "schemaVersion": 41,
  "tags": ["Polar", "RL-Insight", "rollout", "inference"],
  "templating": {"list": [{"current": {}, "hide": 0, "includeAll": true, "label": "Node", "multi": true, "name": "node_id", "options": [], "query": {"query": "label_values(up{job=\"polar-gateway\"}, node_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "refresh": 1, "regex": "", "skipUrlSync": false, "sort": 1, "type": "query"}]},
  "time": {"from": "now-1h", "to": "now"}, "timepicker": {}, "timezone": "browser",
  "title": "Polar Gateway", "uid": "polar-gateway", "version": 1, "weekStart": ""
