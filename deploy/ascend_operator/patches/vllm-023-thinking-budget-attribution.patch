@@ -293,6 +298,37 @@ class ModelRunnerOutput:
         output.kv_connector_output = kv_connector_output
         return output
 
+    def thinking_budget_indices(
+        self, request_id: str, output_offset: int, token_ids: list[int]
+    ) -> list[int] | None:
+        """Verify forcing against accepted tokens, never against a batch slot."""
+        events = self.thinking_budget_forced_tokens
+        if events is None or request_id not in events or not token_ids:
+            return None
+        forced_token = events[request_id]
+        if forced_token is None:
+            return []
+        if token_ids != [forced_token]:
+            raise ValueError(
+                "Thinking-budget forced token does not match sampled output"
+            )
+        return [output_offset]
+
+    def collect_thinking_budget_forcing(
+        self, logits_processors: "LogitsProcessors"
+    ) -> None:
+        """Snapshot plugin attribution before async batch rows move or are reused."""
+        for processor in logits_processors.non_argmax_invariant:
+            collect = getattr(processor, "get_thinking_budget_forced_tokens", None)
+            if collect is not None:
+                events = collect(self.req_ids)
+                if events:
+                    if self.thinking_budget_forced_tokens is not None:
+                        raise ValueError(
+                            "Only one thinking-budget processor is supported"
+                        )
+                    self.thinking_budget_forced_tokens = events
+
 
 # ModelRunnerOutput wrapper for async scheduling.
 class AsyncModelRunnerOutput(ABC):
